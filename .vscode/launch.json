{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "P2 Load Raw CC - Standalone Debug",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/server/debugger/debugp2LoadRawCc.js",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "outputCapture": "std",
            "runtimeArgs": [
                "--trace-warnings"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/server",
            "program": "${workspaceFolder}/server/index.js",
            "env": {
                "DEBUG": "true"
            }
        }
    ]
}