@startuml p1CalculateAiCapacity
skinparam responseMessageBelowArrow true

title
  p1CalculateAiCapacity
end title

participant "requestor" as requestor
participant "p1CalculateAiCapacity" as aiCC #LightCyan

requestor -> aiCC : {channelBandwidth,\nsymbolRateReductionFactor,\nnumberOfStatesInModulation,\ncodeRate}
activate aiCC #LightCyan
  
  note over aiCC
    Calculate AirInterfaceCapacity
    according to ONF TR-532 v2.0 Chapter 6.5
  end note

requestor <-- aiCC : {airInterfaceCapacity}
deactivate aiCC

@enduml
