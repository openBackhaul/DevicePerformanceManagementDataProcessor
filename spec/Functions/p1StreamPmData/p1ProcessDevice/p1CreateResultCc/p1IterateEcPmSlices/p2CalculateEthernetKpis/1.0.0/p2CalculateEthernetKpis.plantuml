@startuml p2CalculateEthernetKpis
skinparam responseMessageBelowArrow true

title
  p2CalculateEthernetKpis
end title

participant "p1IterateEc\nPmSlices" as requestor #LightCyan
participant "p2Calculate\nEthernetKpis" as ethKpis #LightCyan

requestor -> ethKpis : {historicalPerformanceData}
activate ethKpis #LightCyan

    note over ethKpis
      Adds transmitTraffic
    end note

    note over ethKpis
      Adds receiveTraffic
    end note

    note over ethKpis
      Adds frameLossInput
    end note

    note over ethKpis
      Adds frameLossOutput
    end note

requestor <-- ethKpis : {historicalPerformanceData}
deactivate ethKpis

deactivate requestor

@enduml
