@startuml p2DiscardIrrelevantPmRecords
skinparam responseMessageBelowArrow true

title
  p2DiscardIrrelevantPmRecords
end title

participant "requestor\n(e.g. p2LoadRawCc)" as requestor
participant "p1DiscardIrrelevant\nPmRecords" as cur


requestor -> cur: { [historicalPerformanceDataList],\n{offset} }
activate cur

note over cur
  new_mostRecentPeriodEndTime = /offset/mostRecentPeriodEndTime
  new_mostRecentPeriodEndTime24 = /offset/mostRecentPeriodEndTime24
end note

loop FOR all [historicalPerformanceDataList]

  note over cur
    IF periodEndTime is not newer than:
      - 15min: /offset/mostRecentPeriodEndTime
      - 24h: /offset/mostRecentPeriodEndTime24
    THEN discard record
  end note

  note over cur
    Determine measurement.mostRecentPeriodEndTime and measurement.mostRecentPeriodEndTime24
    as the newest periodEndTimes across all 15min or 24h PM slices, respectively,
    seen in historicalPerformanceDataList (also for discarded slices!).
  end note


  note over cur
    IF measurement.mostRecentPeriodEndTime > new_mostRecentPeriodEndTime
    THEN new_mostRecentPeriodEndTime = measurement.mostRecentPeriodEndTime
  end note

  note over cur
    IF measurement.mostRecentPeriodEndTime24 > new_mostRecentPeriodEndTime24
    THEN new_mostRecentPeriodEndTime24 = measurement.mostRecentPeriodEndTime24
  end note

end loop

note over cur
  /offset/mostRecentPeriodEndTime = new_mostRecentPeriodEndTime
  /offset/mostRecentPeriodEndTime24 = new_mostRecentPeriodEndTime24
end note

requestor <-- cur: { [filteredHistoricalPerformanceDataList],\n{offset} }

deactivate cur

@enduml
