@startuml p1Storing
skinparam responseMessageBelowArrow true

title
  p1Storing
end title

participant "p2ProcessDevice\n" as requestor
participant "p1Storing\n" as cur
database "DataStore" as ds


requestor -> cur : { {dataStoreEsClient},\n{resultCc},\n{interfaceMetadataList} }
activate cur

  note over cur
    Locks device
    in DataStore
  end note
  cur -> ds: mountName

  note over cur
    storeInterfaceMetadataList
  end note
  cur -> ds: { [interface-metadata-list] }
  cur <-- ds

  note over cur
    storeResultCc
  end note
  cur -> ds: { {batch} }
  cur <-- ds

  note over cur
    Unlocks device
    in DataStore
  end note
  cur -> ds: mountName

requestor <-- cur

deactivate cur

@enduml
