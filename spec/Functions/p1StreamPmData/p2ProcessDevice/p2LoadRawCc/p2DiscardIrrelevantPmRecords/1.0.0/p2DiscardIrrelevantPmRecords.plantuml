@startuml p2DiscardIrrelevantPmRecords
skinparam responseMessageBelowArrow true

title
  p2DiscardIrrelevantPmRecords
end title

participant "requestor\n(e.g. p2LoadRawCc)" as requestor
participant "p2DiscardIrrelevant\nPmRecords" as cur


requestor -> cur: { [historicalPerformanceDataList],\n{offset} }
activate cur

  note over cur
    Initializes:
      newMostRecentPeriodEndTime
      newMostRecentPeriodEndTime24
  end note


loop FOR EACH record in [historicalPerformanceDataList]

  note over cur
    IF record.periodEndTime is not newer than:
      - 15min: /offset/mostRecentPeriodEndTime
      - 24h: /offset/mostRecentPeriodEndTime24
    THEN discard record
  end note

  note over cur
    updateNewMostRecentPeriodEndTime
  end note

end loop

note over cur
  updateOffset
end note

requestor <-- cur: { [filteredHistoricalPerformanceDataList],\n{offset} }

deactivate cur

@enduml
