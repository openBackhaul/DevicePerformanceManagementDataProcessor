@startuml p1StreamPmData
skinparam responseMessageBelowArrow true

title
  p1StreamPmData
end title

participant "embedYourself\n" as embed
participant "p1StreamPmData\n" as p1RMWDI #LightCyan
participant "p1LoadParameters\n" as p1LP #LightCyan
participant "p1ResolveEsAddress\n" as p1REA #LightCyan
participant "p1InitKafka\n" as p1InitKafka #LightCyan
participant "p1UpdateMwdiReplica\n" as p1UMR #LightCyan
participant "p1ProcessDevice\n" as p1ProcessPm #LightCyan
participant "p1MaintainDs\n" as p1MDS #LightCyan

note right embed
  Automatically starts
  p1StreamPmData
end note
embed -> p1RMWDI : {}
activate p1RMWDI #LightCyan

  p1RMWDI -> p1LP : {functionName=\n"p1StreamPmData"}
  activate p1LP #LightCyan
    note over p1LP
      Loads parameters
      from configFile
    end note
  p1RMWDI <-- p1LP : { {parameters}\n{configFile} }
  deactivate p1LP

  Loop FOR all esName
    p1RMWDI -> p1REA : { {parameters}\n{configFile}\nesName}
    activate p1REA #LightCyan
      note over p1REA
        Resolves ES address
      end note
    p1RMWDI <-- p1REA : { {esAddress} }
    deactivate p1REA
  end Loop

    p1RMWDI -> p1InitKafka : { {parameters}\n{configFile} }
    activate p1InitKafka #LightCyan

      note over p1InitKafka
        Resolves Kafka address
        Establishes session
      end note

    p1RMWDI <-- p1InitKafka
    deactivate p1InitKafka

  p1RMWDI -> p1MDS : { {parameters}\n{dataStoreEsClient} }
  activate p1MDS #LightCyan
    note over p1MDS
      Periodically deletes
      old records
    end note

  loop endless

    p1RMWDI -> p1UMR : { {parameters}\nlastReplicaTime\n{mwdiEsClient}\n{mwdiReplicaEsClient}\n{loggingEsClient} }
    activate p1UMR #LightCyan
      note over p1UMR
        Replicates updated CCs
      end note
    p1RMWDI <-- p1UMR : { [updatedMountNames]\ntimestamp}
    deactivate p1UMR

    loop FOR all [updatedMountNames]
      p1RMWDI -> p1ProcessPm : { {parameters}\n{configFile}\nmountName\n{mwdiReplicaEsClient}\n{dataStoreEsClient} }
      activate p1ProcessPm #LightCyan
        note over p1ProcessPm
          Processes PM data
        end note
      p1RMWDI <-- p1ProcessPm
      deactivate p1ProcessPm
    end loop

  end loop

@enduml
