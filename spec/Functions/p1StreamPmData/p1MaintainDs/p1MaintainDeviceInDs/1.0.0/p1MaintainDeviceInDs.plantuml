@startuml p1MaintainDeviceInDs
skinparam responseMessageBelowArrow true
skinparam SequenceDividerBackgroundColor #LightSalmon

title
  p1MaintainDeviceInDs
end title

participant "p1MaintainDs" as requestor
participant "p1MaintainDeviceInDs" as cur #LightCyan
participant "p1MaintainDevInterfaceInDs" as intf #LightCyan
participant "p1ReadLotTimestampsInDs" as lotTs #LightCyan
database "DataStore" as ds #LightCyan


activate requestor

requestor -> cur : {{parameters},\n{configFile},\n{dataStoreEsClient},\nmountName,\nretentionPeriod}
activate cur #LightCyan

  note over cur #LightGray
    Steps: (box tb removed)
    - maintain device/interface:
      - get interfaceList
      - iterate over interfaceList to maintain each interface
    - delete devices without remaining interfaces:
      - get interfaceCount
      - delete device if interfaceCount==0
    - delete expired lots:
      - get sortedLotTimestamps
      - iterate of each timestamp: delete lot if expired,
        break if not-expired timestamp seen
  end note

  ' Interfaces
  == Maintain device interfaces ==

  note over cur
    <u>GetDeviceInterfaces</u>
      Read the interface list for the mountName
      from [/data-store/device=mountName]
  end note
  cur -> ds: {mountName}
  note over ds #WhiteSmoke
    read
  end note
  cur <-- ds: {{interface}}

  loop FOR EACH interfaceInstance
    note over cur
      Iterate over interface and call the
      function for each record.
      <u>p1MaintainDevInterfaceInDs</u>
    end note
    cur -> intf: {{parameters},\n{configFile},\n{dataStoreEsClient},\nmountName,\nretentionPeriod,\n{interfaceInstance}}
    activate intf #LightCyan
      note over intf
        Deletes the interfaceInstance
        from DS if expired
      end note
      intf -> ds
      note over ds #WhiteSmoke
        delete
      end note
      intf <-- ds
    cur <-- intf
    deactivate intf

  end loop

  ' Device deletion
  == Delete the device from DS if expired ==

  note over cur
    <u>GetInterfaceCount</u>
  end note
  cur -> ds: {mountName}
  note over ds #WhiteSmoke
    read
  end note
  cur <-- ds: {interfaceCount}

  note over cur
    <u>DeleteExpiredDevice</u>
    IF (interfaceCount==0)
    THEN DELETE complete device [/data-store/device=mountName]
         from dataStore
         and exit
  end note
  cur -> ds: {mountName}
  note over ds #WhiteSmoke
    delete
  end note
  cur <-- ds
  requestor <-- cur: (if device deleted)

  ' Lot deletion
  == Delete expired lots for the device from dataStore ==

  note over cur
    <u>p1ReadLotTimestampsFromDs</u>
      Read the lot timestamps from dataStore.
      They are returned sorted from oldest to newest date.
  end note
  cur -> lotTs: {mountName,\n{{parameters=/sub-function=p1ReadLotTimestampsFromDs}},\n{dataStoreEsClient},\n{configFile}}
  activate lotTs #LightCyan
    lotTs -> ds
    note over lotTs
      Read and sort list of
      lot timestamps
    end note
    note over ds #WhiteSmoke
    read
    end note
    lotTs <-- ds
  cur <-- lotTs: {{sortedLotTimestamps}}
  deactivate lotTs


  loop FOR EACH timestamp in sortedLotTimestamps
    note over cur
      <u>DeleteExpiredLots</u>
        IF (timestamp older than allowed by retentionPeriod)
        THEN DELETE related lot from datastore:
          [/data-store/device=mountName/lot=timestamp]
        ELSE
          break
        
        As soon as a timestamp is encountered, that is not
        expired, the lot cleanup is finished due to
        timestamps being sorted.
    end note

  cur -> ds: {mountName, timestamp}
  note over ds #WhiteSmoke
    delete
  end note
  cur <-- ds

  end loop

requestor <-- cur

deactivate cur




@enduml
