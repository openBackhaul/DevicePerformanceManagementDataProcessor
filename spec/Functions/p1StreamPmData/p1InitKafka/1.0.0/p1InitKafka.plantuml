@startuml p1InitKafka
skinparam responseMessageBelowArrow true

title
  p1InitKafka
end title

participant "requestor\n" as requestor
participant "p1InitKafka\n" as p1Init #LightCyan
participant "kafkaProducerService.\nconnect" as p1KafkaP #LightCyan
participant "kafkaConsumerService.\nconnect" as p1KafkaC #LightCyan
queue "kafka\n" as kafka

requestor -> p1Init : { {parameters},\n{configFile} }
activate p1Init #LightCyan

  note over p1Init
    Resolves Kafka address
    and connection parameters
  end note

  loop For all [client]

    note over p1Init
      IF clientType == 'producer'
    end note

    note right p1Init
      THEN
    end note

    p1Init -> p1KafkaP : {clientId,\nbrokerList}
    activate p1KafkaP #LightCyan

      note over p1KafkaP
        Establishes producer
        session to Kafka
      end note
      p1KafkaP -> kafka : {CONNECT event}
      p1KafkaP <-- kafka

    p1Init <-- p1KafkaP

    note over p1Init
      ELSEIF clientType == 'consumer'
    end note

    note right p1Init
      THEN
    end note

    p1Init -> p1KafkaC : {groupId,\nclientId,\nbrokerList}
    activate p1KafkaC #LightCyan

      note over p1KafkaC
        Establishes consumer
        session to Kafka
      end note
      p1KafkaC -> kafka : {CONNECT event}
      p1KafkaC <-- kafka

    p1Init <-- p1KafkaC

  end loop

requestor <-- p1Init
deactivate p1Init

@enduml
