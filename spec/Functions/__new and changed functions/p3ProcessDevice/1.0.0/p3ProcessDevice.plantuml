@startuml p3ProcessDevice
skinparam responseMessageBelowArrow true

title
  p3ProcessDevice
end title

participant "p2StreamPmData\n" as requestor
participant "p3ProcessDevice\n" as cur
participant "p1LoadOffsets\nAndStatusData" as p1Offset
participant "p3LoadRawCc\n" as p3AddRaw
participant "p3CreateResultCc\n" as p3CreateResCc
participant "p2Formatting\nOutputApt" as p2OutputApt
participant "p2Formatting\nOutputOnf" as p2OutputOnf
participant "p1Transmitting\nKafka" as p1Trans
participant "p2Storing\n" as p2Store

requestor -> cur : { {parameters},\n{configFile},\nmountName,\n{mwdiEsClient},\n{dataStoreEsClient} }
activate cur

  'LoadOffsetsAndStatusData
  cur -> p1Offset: { mountName,\n{dataStoreEsClient} }
  activate p1Offset

    note over p1Offset
      Loads offsets and statusData
      from DataStore
    end note

  cur <-- p1Offset: { [offsets],\n[statusData] }
  deactivate p1Offset

  'LoadRawCc
  cur -> p3AddRaw : { {/parameters/sub-function=p2LoadRawCc},\n{mwdiEsClient},\nmountName,\n[offsets] }
  activate p3AddRaw

    note over p3AddRaw
      - Loads rawCc from MWDI ES
      - Reduces structure of rawCc
      - Deletes PM data that has
        already been processed in past
      - Returns updated offsets
        (mostRecentPeriodEndTimes)
      - Returns device PM quality data
    end note

  cur <-- p3AddRaw : { {rawCc},\n[offsets],\n{deviceQualityPmData} }
  deactivate p3AddRaw

  'CreateResultCc
  cur -> p3CreateResCc : { {/parameters/sub-function=p3CreateResultCc},\n{rawCc},\n[statusData] }
  activate p3CreateResCc

    note over p3CreateResCc
      - Creates resultCc from rawCc
      - Processes and complements PM data
      - Updates statusData
    end note

  cur <-- p3CreateResCc :  { {resultCc},\n[statusData] }
  deactivate p3CreateResCc

  'FormattingOutputApt
  cur -> p2OutputApt : { {resultCc} }
  activate p2OutputApt

    note over p2OutputApt
      Creates aptOutputFormat
      from resultCc
    end note

  cur <-- p2OutputApt : { formatName,\n{outputFormat} }
  deactivate p2OutputApt

  'FormattingOutputOnf
  cur -> p2OutputOnf : { {/parameters/sub-function=p2FormattingOutputOnf},\n{resultCc} }
  activate p2OutputOnf

    note over p2OutputOnf
      Creates [onfOutputFormat]
      from resultCc
    end note

  cur <-- p2OutputOnf : [ onfOutputFormat ]
  deactivate p2OutputOnf

  'TransmittingKafka
  cur -> p1Trans : { {/parameters/sub-function=p1TransmittingKafka},\n{configFile},\n[outputFormat] }
  activate p1Trans

    note over p1Trans
      Transmits object
      to Kafka
    end note

  cur <-- p1Trans
  deactivate p1Trans

  'Storing
  cur -> p2Store : { {/parameters/sub-function=p2Storing},\n{dataStoreEsClient},\n{resultCc},\n[offsets],\n[statusData] }
  activate p2Store

    note over p2Store
      Stores resultCc
    end note

  cur <-- p2Store
  deactivate p2Store

  requestor <-- cur: { {deviceQualityPmData} }

deactivate cur

@enduml
