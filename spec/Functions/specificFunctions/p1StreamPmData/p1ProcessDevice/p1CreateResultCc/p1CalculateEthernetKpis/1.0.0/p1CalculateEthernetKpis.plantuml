@startuml p1CalculateEthernetKpis
skinparam responseMessageBelowArrow true

title
  p1CalculateEthernetKpis
end title

participant "p1CreateResultCc\n" as requestor #LightGrey
participant "p1Calculate\nEthernetKpis" as ethKpis #LightCyan

requestor -> ethKpis : {[historicalPerformanceDataList]}
activate ethKpis #LightCyan

  loop FOR all [historicalPerformanceDataList]

    note over ethKpis
      Add transmitTraffic
    end note

    note over ethKpis
      Add receiveTraffic
    end note

    note over ethKpis
      Add frameLossInput
    end note

    note over ethKpis
      Add frameLossOutput
    end note

  end loop

requestor <-- ethKpis : {[historicalPerformanceDataList]}
deactivate ethKpis

deactivate requestor

@enduml
