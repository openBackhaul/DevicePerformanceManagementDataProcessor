@startuml p1FormattingOutputApt
skinparam responseMessageBelowArrow true

title
p1FormattingOutputApt
end title

participant "requestor\n(e.g. p1ProcessingOrchestratorForHistoricalPm)" as requestor
participant "p1FormattingOutputApt" as cur #LightCyan

requestor -> cur: {_resultCC}

  note over cur #LightCoral
    REMINDER:
    LAG information not yet included in schema of resultCC,
    therefore in interface.yaml mapping needs to be once
    this info becomes available in resultCC!
  end note

  note over cur
    Transform resultCC data into
    APT output format.

    Only reasonable data to be provided.
    Attributes missing in input will
    be omitted in output.
  end note
  activate cur #LightCyan

requestor <-- cur: {output}

deactivate cur
