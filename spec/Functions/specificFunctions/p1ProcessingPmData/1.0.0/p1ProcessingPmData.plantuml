@startuml p1ProcessingPmData
skinparam responseMessageBelowArrow true

title
  p1ProcessingPmData
end title

participant "p1ReplicateMwdiEs\n" as requestor
participant "p1ProcessingPmData\n" as p1ProOrch #LightCyan
participant "p1LoadRawCc\n" as p1AddRaw #LightCyan
participant "p1CreateResultCc\n" as p1CRC #LightCyan
participant "p1Formatting\nOutputApt" as p1Output #LightCyan
participant "p1Transmitting\nKafka" as p1Trans #LightCyan
participant "p1Storing\n" as p1Store #LightBlue
database "dataStore" as db #LightBlue


activate requestor

requestor -> p1ProOrch : {mountName,\n{parameters}}
activate p1ProOrch #LightCyan

  note over p1ProOrch
    Create
    DataStructureForProcessing
  end note

  p1ProOrch -> p1AddRaw : {mountName,\n{/parameters/sub-function=loadRawCc}}
  activate p1AddRaw #LightCyan

    note over p1AddRaw
      - Load rawCC from MWDI ES
      - Reduce structure of rawCC
      - Delete PM data that has
        already been processed in past
    end note

  p1ProOrch <-- p1AddRaw : {rawCC}
  deactivate p1AddRaw

  note over p1ProOrch
    Add rawCC to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1CRC : {_rawCC,\n{/parameters/sub-function=createResultCc}}
  activate p1CRC #LightCyan

    note over p1CRC
      - Create resultCC from rawCC
      - Process and complement PM data
    end note

  p1ProOrch <-- p1CRC : {_resultCC}
  deactivate p1CRC

  note over p1ProOrch
    Add resultCC to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1Output : {_resultCC,\n{/parameters/sub-function=p1FormattingOutputApt}}
  activate p1Output #LightCyan

    note over p1Output
      Create aptOutputFormat
      from resultCC
    end note

  p1ProOrch <-- p1Output : {aptOutputFormat}
  deactivate p1Output

  note over p1ProOrch
    Add aptOutputFormat to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1Trans : {_outputFormat,\n{/parameters/sub-function=p1TransmittingKafka}}
  activate p1Trans #LightCyan

    note over p1Trans
      Transmit outputFormat
      via Kafka
    end note

  p1ProOrch <-- p1Trans
  deactivate p1Trans

  p1ProOrch -> p1Store : {_resultCC,\n{/parameters/sub-function=p1Storing}}
  activate p1Store #LightBlue

    note over p1Store
      Store resultCC
    end note

    p1Store -> db

  p1ProOrch <-- p1Store
  deactivate p1Store

deactivate p1ProOrch

@enduml
