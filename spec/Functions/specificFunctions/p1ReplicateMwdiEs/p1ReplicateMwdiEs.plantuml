@startuml p1ReplicateMwdiEs
skinparam responseMessageBelowArrow true

title
  p1ReplicateMwdiEs
end title

participant "embedYourself\n" as embed
participant "p1ReplicateMwdiEs\n" as p1RMWDI #LightCyan
participant "p1LoadParameters\n" as p1LP #LightCyan
database "configFile" as configFile #LightCyan

database "MwdiEs" as mwdiEs #LightCyan
database "MwdiEsReplica" as mwdiEsReplica #LightCyan
database "ReplicateMwdiEsLog" as log #LightCyan

participant "p1ProcessingPmData\n" as p1ProOrch #LightCyan
participant "p1MaintainDs\n" as p1MDS #LightBlue

note right embed
  Automatically start
  p1ReplicateMwdiEs
end note
embed -> p1RMWDI : {}
activate p1RMWDI #LightCyan

  p1RMWDI -> p1LP : {functionName=\n"p1ReplicateMwdiEs"}
  activate p1LP #LightCyan
    note over p1LP
      Load parameters
      from configFile
    end note
  p1RMWDI <-- p1LP : {parameters}
  deactivate p1LP

  note over p1RMWDI
    _mwdiEsClient = /parameters/parameter=mwdiEsClient/value
    _mwdiHttpClient = /parameters/parameter=mwdiHttpClient/value
    _mwdiTcpClient = /parameters/parameter=mwdiTcpClient/value
    _mwdiReplicaEsClient = /parameters/parameter=mwdiReplicaEsClient/value
    _mwdiReplicaHttpClient = /parameters/parameter=mwdiReplicaHttpClient/value
    _mwdiReplicaTcpClient = /parameters/parameter=mwdiReplicaTcpClient/value
    _replicateMwdiEsLogEsClient = /parameters/parameter=replicateMwdiEsLogEsClient/value
    _replicateMwdiEsLogHttpClient = /parameters/parameter=replicateMwdiEsLogHttpClient/value
    _replicateMwdiEsLogTcpClient = /parameters/parameter=replicateMwdiEsLogTcpClient/value
    _dataStoreEsClient = /parameters/parameter=dataStoreEsClient/value
    _dataStoreHttpClient = /parameters/parameter=dataStoreHttpClient/value
    _dataStoreTcpClient = /parameters/parameter=dataStoreTcpClient/value
  end note

  note right p1RMWDI
    Load detailed address information 
    (incl. EsClient, HttpClient, TcpClient)
    of ElasticSearch indexes for:
    - MWDI ES
    - MWDI ES Replica
    - Logging of MWDI ES Replication
    - DataStore
  end note
  p1RMWDI -> configFile
  p1RMWDI <-- configFile

  p1RMWDI -> p1MDS : {addressOfReplicateMwdiEsLog,\nparameters}
  activate p1MDS #LightBlue
    note over p1MDS
      Maintain DataStore
    end note

  group Cyclically update MWDI ES Replica

    note right p1RMWDI
      - read last-complete-control-construct-update-time-attempt attribute
        for all devices in the MWDI ES index
      - read entire CC for all devices with
        last-complete-control-construct-update-time-attempt attribute > lastReplicationTimestamp
    end note
    p1RMWDI -> mwdiEs
    p1RMWDI <-- mwdiEs

    note right p1RMWDI
      Replicate updated CCs
    end note
    p1RMWDI -> mwdiEsReplica
    p1RMWDI <-- mwdiEsReplica

    note right p1RMWDI
      Log results of replication
    end note
    p1RMWDI -> log : {cronjobName,\nlastReplicationTimestamp,\nstatusMessage}


    note over p1RMWDI #Orange
      there is also some delete activity to be described here
    end note



    group Trigger processing of updated CC
      p1RMWDI -> p1ProOrch : {mountName}
      activate p1ProOrch #LightCyan
        note over p1ProOrch
          Process PM data
          of device
        end note
    end

  end

@enduml
