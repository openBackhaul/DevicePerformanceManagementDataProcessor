@startuml p1ReplicateMwdiEs
skinparam responseMessageBelowArrow true

title
  p1ReplicateMwdiEs
end title

participant "embedYourself\n" as embed
participant "p1ReplicateMwdiEs\n" as p1RMWDI #LightCyan
participant "p1LoadParameters\n" as p1LP #LightCyan
database "configFile" as configFile #LightCyan

database "MwdiEs" as mwdiEs #LightCyan
database "MwdiEsReplica" as mwdiEsReplica #LightCyan
database "ReplicateMwdiEsLog" as log #LightCyan

participant "p1ProcessingPmData\n" as p1ProOrch #LightCyan
participant "p1MaintainDs\n" as p1MDS #LightBlue

note right embed
  Automatically start
  p1ReplicateMwdiEs
end note
embed -> p1RMWDI : {}
activate p1RMWDI #LightCyan

  p1RMWDI -> p1LP : {functionName=\np1ReplicateMwdiEs}
  activate p1LP #LightCyan
    note over p1LP
      Load parameters
      from configFile
    end note
  p1RMWDI <-- p1LP : {function}
  deactivate p1LP

  note over p1RMWDI
    _mwdiEsClient = /function/parameter=mwdiEsClient/value
    _mwdiHttpClient = /function/parameter=mwdiHttpClient/value
    _mwdiTcpClient = /function/parameter=mwdiTcpClient/value
    _mwdiReplicaEsClient = /function/parameter=mwdiReplicaEsClient/value
    _mwdiReplicaHttpClient = /function/parameter=mwdiReplicaHttpClient/value
    _mwdiReplicaTcpClient = /function/parameter=mwdiReplicaTcpClient/value
    _replicateMwdiEsLogEsClient = /function/parameter=replicateMwdiEsLogEsClient/value
    _replicateMwdiEsLogHttpClient = /function/parameter=replicateMwdiEsLogHttpClient/value
    _replicateMwdiEsLogTcpClient = /function/parameter=replicateMwdiEsLogTcpClient/value
    _dataStoreEsClient = /function/parameter=dataStoreEsClient/value
    _dataStoreHttpClient = /function/parameter=dataStoreHttpClient/value
    _dataStoreTcpClient = /function/parameter=dataStoreTcpClient/value
  end note

  note right p1RMWDI
    Load detailed address information 
    (incl. EsClient, HttpClient, TcpClient)
    of ElasticSearch indexes for:
    - MWDI ES
    - MWDI ES Replica
    - Logging of MWDI ES Replication
    - DataStore
  end note
  p1RMWDI -> configFile
  p1RMWDI <-- configFile

  p1RMWDI -> p1MDS : {addressOfReplicateMwdiEsLog,\nfunction}
  activate p1MDS #LightBlue
    note over p1MDS
      Maintain DataStore
    end note

  group Cyclically update MWDI ES Replica

    note right p1RMWDI
      Read CCs with dates that indicate an updated
    end note
    p1RMWDI -> mwdiEs
    p1RMWDI <-- mwdiEs

    note right p1RMWDI
      Replicate updated CCs
    end note
    p1RMWDI -> mwdiEsReplica
    p1RMWDI <-- mwdiEsReplica

    note right p1RMWDI
      Log results of replication
    end note
    p1RMWDI -> log : {cronjobName,\nlastReplicationTimestamp,\nstatusMessage}

    group Trigger processing of updated CC
      p1RMWDI -> p1ProOrch : {mountName}
      activate p1ProOrch #LightCyan
        note over p1ProOrch
          Process PM data
          of device
        end note
    end

  end

@enduml
