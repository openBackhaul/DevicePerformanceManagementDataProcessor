@startuml diagram
skinparam responseMessageBelowArrow true

title
  p1ExtractNewPmData
end title

participant "requestor\ne.g. p1ProvideListOfInterfacesToBeProcessed" as requestor
participant "p1ExtractNewPmData" as ENPD #LightBlue
database "DPMDP\nPM data store" as DPMDP
database "MWDI\nCache Replica" as MWDI

requestor -> ENPD : {MountName, uuid, localId, layerProtocolName}
activate ENPD

note over ENPD #LightGray
  most recent timestamp ermitteln
end note

note over ENPD #LightGray
  PM daten aus MWDI holen
end note

note over ENPD #LightGray
  PM daten auf 15min filtern
end note

note over ENPD #LightGray
  PM daten auf neuer als most recent timestamp filtern
end note

requestor <-- ENPD : [{newPmData}]

deactivate ENPD

@enduml




PM data store:
  - DeviceName
    - uuid
      - local-id
        MostRecentTimestamp
        Output


PM data store:
  - DeviceName
    - Output

PM data store:
  - DeviceName
    - DSFP

