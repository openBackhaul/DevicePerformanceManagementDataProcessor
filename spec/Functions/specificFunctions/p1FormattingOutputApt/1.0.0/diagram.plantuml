@startuml diagram
skinparam responseMessageBelowArrow true

title
p1FormattingOutputApt
end title

participant "requestor\n(e.g. p1ProcessingOrchestratorForHistoricalPm)" as requestor
participant "p1FormattingOutputApt" as cur #LightCyan
participant "p1ComputeAirInterfaceNames" as airIfNames #LightCyan
participant "p1ComputeAirIfLag" as airIfLag #LightCyan
participant "p1ComputeEthContainerName" as ethName #LightCyan



note over requestor #LightGray
  The requestor hands over the reference to
  a ControlConstruct object following ONF format.
  The actual CC object may be enriched with additional
  attributes (non-ONF). In case such additional attributes
  are to be read in the further processing, but are not available
  in the input CC object, (non-key) attributes in the output
  that cannot be mapped shall be set to a default
  (integer: -1, string: emptyString).
end note

requestor -> cur: {_CC, {input}, {parameters}}


activate cur #LightCyan

group CreateOutput

  note over cur
    The input CC data in ONF format is transformed
    into the desired APT output format.

    While adding AirInterface and EthernetContainer data
    from the referenced CC data, interfaceNames and LinkAggregation
    information is computed for each interface instance
    by calling the respective generic functions. 
  end note

  note over cur
    For the current airInterface, 
    - compute interfaceNames (linkEndpointId, linkId)
    - compute LAG information

    Add both to air-interface-identifiers.
  end note

  cur -> airIfNames: {_CC | LtpStructureAndAugment, uuid, {input}, {parameters}}
  cur <-- airIfNames: {linkEndpointId, linkId}

  cur -> airIfLag: {_CC | LtpStructureAndAugment, uuid, {input}, {parameters}}
  cur <-- airIfLag: {Lag} 

  note over cur
    For the current EthernetContainer, 
    - compute interfaceName (i.e. the portName)
    - compute LAG information

    Add it to ethernet-container-identifiers.
  end note
  cur -> ethName: {_CC | LtpStructureAndAugment, uuid, {input}, {parameters}}
  cur <-- ethName: {interfaceName}

end group



requestor <-- cur: {output}

deactivate cur

