@startuml hl_sequence
skinparam responseMessageBelowArrow true

title
  DevicePerformanceManagementDataProcessor
end title

participant "embedYourself\n" as embed
participant "p1ReplicateMwdiEs\n" as p1ReplaceMwdiEs #LightCyan
participant "p1LoadParameters\n" as p1LoadParams #LightCyan
database "configFile" as configFile #LightCyan

participant "p1ProcessingPmData\n" as p1ProcessPm #LightCyan

participant "p1LoadRawCc\n" as p1AddRaw #LightGreen
database  "MWDI ES\nReplica" as MwdiEs #LightCyan
participant "p1FieldsFilter\n" as p1FieldsFilter #LightGreen
participant "p1DiscardIrrelevant\nPmRecords" as filterPm #LightGreen

participant "p1CreateResultCc\n" as p1CreateResultCC #LightCyan
participant "p1Default\nValueTreatment" as p1DefaultValues #LightBlue
participant "p1OutOfRange\nValueTreatment" as p1OutOfRange #LightBlue

participant "p1AirInterface\nCapacityCalculation" as p1AirKpi #LightBlue
participant "p1Ethernet\nKpiCalculation" as p1EthKpi #LightBlue

participant "p1Formatting\nOutputApt" as p1Output #LightCyan
participant "p1Compute\nAirInterfaceNames" as p1CompAiNames #LightCyan
participant "p1Compute\nAirInterfacePhysicalLag" as p1CompPhyLag #LightCyan
participant "p1Compute\nEthContainerNames" as p1CompEthContNames #LightCyan

participant "p1Transmitting\nKafka" as p1Trans #LightCyan

participant "p1Storing\n" as p1Store #LightBlue
participant "p1MaintainDs\n" as p1MDS #LightBlue
database "dataStore" as db #LightBlue

note right embed
  Automatically start
  p1ReplicateMwdiEs
end note
embed -> p1ReplaceMwdiEs

' replicate MWDI ES ->
activate p1ReplaceMwdiEs #LightCyan

  p1ReplaceMwdiEs -> p1LoadParams
  activate p1LoadParams #LightCyan
    note right p1LoadParams
      Load parameters
      from configFile
    end note
    p1LoadParams -> configFile
    p1LoadParams <-- configFile
  p1ReplaceMwdiEs <-- p1LoadParams
  deactivate p1LoadParams

  p1ReplaceMwdiEs -> p1MDS
  activate p1MDS #LightBlue
    loop
      note over p1MDS
        Maintain DataStore
      end note
    end

  loop 
    note over p1ReplaceMwdiEs
      Update MWDI ES Replica
    end note

    p1ReplaceMwdiEs -> p1ProcessPm : for every\nupdated CC
    activate p1ProcessPm #LightCyan

      note over p1ProcessPm
        Create
        DataStructureForProcessing
      end note

      ' create RawCC ->
      p1ProcessPm -> p1AddRaw
      activate p1AddRaw #LightGreen

        p1AddRaw -> MwdiEs
        p1AddRaw <-- MwdiEs

        ' apply fieldsFilter ->
        p1AddRaw -> p1FieldsFilter
        activate p1FieldsFilter #LightGreen

          note over p1FieldsFilter
            Reduce structure of rawCC
          end note

        p1AddRaw <-- p1FieldsFilter
        deactivate p1FieldsFilter

        ' get mostRecentPeriodEndTimes
        p1AddRaw -> db
        p1AddRaw <-- db

        ' discard irrelevant PM records
        p1AddRaw -> filterPm
        activate filterPm #LightGreen

          note over filterPm
            Delete PM data that has
            already been processed in past
          end note

        p1AddRaw <-- filterPm
        deactivate filterPm

      p1ProcessPm <-- p1AddRaw
      deactivate p1AddRaw

      note over p1ProcessPm
        Add rawCC to
        DataStructureForProcessing
      end note

      ' create resultCC ->
      p1ProcessPm -> p1CreateResultCC
      activate p1CreateResultCC #LightCyan

        note over p1CreateResultCC
          Create resultCC
          from rawCC
        end note

        ' process default values ->
        p1CreateResultCC -> p1DefaultValues
        activate p1DefaultValues #LightBlue

          note over p1DefaultValues
            Delete attributes with ONF
            default value from resultCC
          end note

        p1CreateResultCC <-- p1DefaultValues
        deactivate p1DefaultValues

        ' process outOfRange values ->
        p1CreateResultCC -> p1OutOfRange
        activate p1OutOfRange #LightBlue

          note over p1OutOfRange
            Delete attributes with value outside
            pre-defined range from resultCC
          end note

        p1CreateResultCC <-- p1OutOfRange
        deactivate p1OutOfRange

        ' get AirIf KPIs ->
        p1CreateResultCC -> p1AirKpi
        activate p1AirKpi #LightBlue

          note over p1AirKpi
            Add AirInterface capacity
            to resultCC
          end note

        p1CreateResultCC <-- p1AirKpi
        deactivate p1AirKpi

        ' get EthContainer KPIs ->
        p1CreateResultCC -> p1EthKpi
        activate p1EthKpi #LightBlue

          note over p1EthKpi
            Add Ethernet KPIs
            to resultCC
          end note

        p1CreateResultCC <-- p1EthKpi
        deactivate p1EthKpi

      p1ProcessPm <-- p1CreateResultCC
      deactivate p1CreateResultCC

      note over p1ProcessPm
        Add resultCC to
        DataStructureForProcessing
      end note

      ' Format OutputAPT ->
      p1ProcessPm -> p1Output
      activate p1Output #LightCyan

        note over p1Output
          Create APT format
          from resultCC
        end note

        ' compute AirIf names ->
        p1Output -> p1CompAiNames
        activate p1CompAiNames #LightCyan

          note over p1CompAiNames
            Determine LinkId 
            and LinkEndpointId
          end note

        p1Output <-- p1CompAiNames
        deactivate p1CompAiNames

        ' compute AirIf LAG ->
        p1Output -> p1CompPhyLag
        activate p1CompPhyLag #LightCyan

          note over p1CompPhyLag
            Determine LinkIds and
            PortNames (WireInterfaces)
            in aggregation group
          end note

        p1Output <-- p1CompPhyLag
        deactivate p1CompPhyLag

        ' compute EthContainer names ->
        p1Output -> p1CompEthContNames
        activate p1CompEthContNames #LightCyan

          note over p1CompEthContNames
            Determine PortNames
            of EthernetContainers
          end note

        p1Output <-- p1CompEthContNames
        deactivate p1CompEthContNames

        note over p1Output
          Consolidate data
          into APT format
        end note

      p1ProcessPm <-- p1Output
      deactivate p1Output

      note over p1ProcessPm
        Add APT format to
        DataStructureForProcessing
      end note

      ' transmit data ->
      p1ProcessPm -> p1Trans
      activate p1Trans #LightCyan

        note over p1Trans
          Transmit APT format
        end note

      p1ProcessPm <-- p1Trans
      deactivate p1Trans

      ' storing ->
      p1ProcessPm -> p1Store
      activate p1Store #LightBlue

        note over p1Store
          Store resultCC
        end note

        p1Store -> db

      p1ProcessPm <-- p1Store
      deactivate p1Store

    deactivate p1ProcessPm

  end

@enduml
