@startuml hl_sequence
skinparam responseMessageBelowArrow true

title
  DevicePerformanceManagementDataProcessor
end title

participant "embedYourself\n" as embed
participant "p1StreamPmData\n" as p1StreamPm #LightBlue
participant "p1LoadParameters\n" as p1LoadParams #LightBlue
participant "p1ResolveEsAddress\n" as p1ResolveAddress #LightBlue
participant "p1InitKafka\n" as p1InitKafka #LightBlue
participant "p1UpdateMwdiReplica\n" as p1UpdateMwdiRep #LightBlue

participant "p1ProcessDevice\n" as p1ProcessPm #LightBlue

participant "p1LoadRawCc\n" as p1AddRaw
participant "p1FieldsFilter\n" as p1FieldsFilter
participant "p1DiscardIrrelevant\nPmRecords" as filterPm

participant "p1CreateResultCc\n" as p1CreateResultCc #LightCyan
participant "p1Prepare\nTxModes" as p1prepTxModes
participant "p1Calculate\nAiCapacity" as aiCC
participant "p1IterateAi\nPmSlices" as aiSlices
participant "p1Calculate\nIntervalCapacity" as intCC
participant "p1RemoveOutOf\nRangeLevels" as p1RORL
participant "p1Remove\nDefaultValues" as p1RemDefault
participant "p1IterateEc\nPmSlices" as ecSlices
participant "p1Calculate\nEthernetKpis" as p1EthKpi
participant "p1Calculate\nUtilization" as p1Util
participant "p1RemoveOutOf\nRangeTemperature" as p1ROoRT #LightCyan

participant "p1Formatting\nOutputApt" as p1OutputApt #LightCyan
participant "p1Formatting\nOutputOnf" as p1OutputOnf #LightCyan

participant "p1Transmitting\nKafka" as p1Trans #LightBlue

participant "p1Storing\n" as p1Store #LightCyan
participant "p1MaintainDs\n" as p1MaintainDs #LightCyan

note right embed
  Automatically starts
  p1StreamPmData
end note
embed -> p1StreamPm

' replicate MWDI ES ->
activate p1StreamPm #LightBlue

  p1StreamPm -> p1LoadParams
  activate p1LoadParams #LightBlue
    note over p1LoadParams
      Loads parameters
      from configFile
    end note
  p1StreamPm <-- p1LoadParams
  deactivate p1LoadParams

  Loop FOR all esName
    p1StreamPm -> p1ResolveAddress
    activate p1ResolveAddress #LightBlue
      note over p1ResolveAddress
        Resolves ES address
      end note
    p1StreamPm <-- p1ResolveAddress
    deactivate p1ResolveAddress

  end Loop

  p1StreamPm -> p1InitKafka
  activate p1InitKafka #LightBlue

    note over p1InitKafka
      Resolves Kafka
      address
    end note

    note over p1InitKafka
      Establishes Kafka
      session
    end note

  p1StreamPm <-- p1InitKafka
  deactivate p1InitKafka

  p1StreamPm -> p1MaintainDs
  activate p1MaintainDs #LightCyan

  Loop endless
    note over p1MaintainDs
      Deletes old
      resultCc
    end note
  end loop

  Loop endless

    p1StreamPm -> p1UpdateMwdiRep
    activate p1UpdateMwdiRep #LightBlue
      note over p1UpdateMwdiRep
        Replicates updated CCs
      end note
    p1StreamPm <-- p1UpdateMwdiRep
    deactivate p1UpdateMwdiRep

    Loop for every updated CC

      p1StreamPm -> p1ProcessPm
      activate p1ProcessPm #LightBlue

        p1ProcessPm -> p1AddRaw
        activate p1AddRaw

          note over p1AddRaw
            Loads raw data to rawCc
          end note

          p1AddRaw -> p1FieldsFilter
          activate p1FieldsFilter

            note over p1FieldsFilter
              Reduces structure of rawCc
            end note

          p1AddRaw <-- p1FieldsFilter
          deactivate p1FieldsFilter

          note over p1AddRaw
            Get mostRecentPeriodEndTimes
          end note

          p1AddRaw -> filterPm
          activate filterPm

            note over filterPm
              Deletes PM data that has
              already been processed in past
            end note

          p1AddRaw <-- filterPm
          deactivate filterPm

          note over p1AddRaw
            addBatchTimestamp
          end note

        p1ProcessPm <-- p1AddRaw : {rawCc}
        deactivate p1AddRaw

        p1ProcessPm -> p1CreateResultCc
        activate p1CreateResultCc #LightCyan

          note over p1CreateResultCc
            Copies rawCc to resultCc
          end note

          note over p1CreateResultCc
            Creates aggregationGroupList
          end note

          loop FOR all AirInterfaces in resultCc

            p1CreateResultCc -> p1prepTxModes
            activate p1prepTxModes

              note over p1prepTxModes
                Prepares TxModes
              end note

              p1prepTxModes -> aiCC
              activate aiCC

                note over aiCC
                  Calculates
                  AirInterfaceCapacity
                end note

              p1prepTxModes <-- aiCC
              deactivate aiCC

            p1CreateResultCc <-- p1prepTxModes
            deactivate p1prepTxModes

            p1CreateResultCc -> aiSlices
            activate aiSlices

                aiSlices -> intCC
                activate intCC

                  note over intCC
                    Calculates
                    IntervalCapacity
                  end note

                aiSlices <-- intCC
                deactivate intCC

                aiSlices -> p1RORL
                activate p1RORL

                  note over p1RORL
                    Deletes RxLevel and TxLevel
                    attributes with values
                    outside pre-defined range
                  end note

                aiSlices <-- p1RORL
                deactivate p1RORL

                aiSlices -> p1RemDefault
                activate p1RemDefault

                  note over p1RemDefault
                    Deletes attributes with
                    ONF default value
                  end note

                aiSlices <-- p1RemDefault
                deactivate p1RemDefault

                note over aiSlices
                  Derives most recent
                  periodEndTime
                end note

            p1CreateResultCc <-- aiSlices
            deactivate aiSlices

            note over p1CreateResultCc
              Update interfaceMetadata
            end note

            note over p1CreateResultCc
              Add linkId
            end note

            note over p1CreateResultCc
              Add list of parallel LTPs
            end note

          end loop

          loop FOR all EthernetContainers in resultCc

            p1CreateResultCc -> ecSlices
            activate ecSlices

              ecSlices -> p1EthKpi
              activate p1EthKpi

                note over p1EthKpi
                  Add Ethernet KPIs
                end note

              ecSlices <-- p1EthKpi
              deactivate p1EthKpi

              ecSlices -> p1RemDefault
              activate p1RemDefault

                note over p1RemDefault
                  Deletes default values
                  from Ec Pm data
                end note

              ecSlices <-- p1RemDefault
              deactivate p1RemDefault

              ecSlices -> p1Util
              activate p1Util

                note over p1Util
                  Add utilization
                end note

              ecSlices <-- p1Util
              deactivate p1Util

              note over ecSlices
                Derives most recent
                periodEndTime
              end note

            p1CreateResultCc <-- ecSlices
            deactivate ecSlices

            note over p1CreateResultCc
              Update interfaceMetadata
            end note

          end loop

          p1CreateResultCc -> p1ROoRT
          activate p1ROoRT #LightCyan

            note over p1ROoRT
              Delete temperature attributes with
              values outside pre-defined range
            end note

          p1CreateResultCc <-- p1ROoRT
          deactivate p1ROoRT

        p1ProcessPm <-- p1CreateResultCc : {resultCc}
        deactivate p1CreateResultCc

        p1ProcessPm -> p1OutputApt
        activate p1OutputApt #LightCyan

          note over p1OutputApt
            Create APT format
          end note

        p1ProcessPm <-- p1OutputApt : {aptOutputFormat}
        deactivate p1OutputApt

        p1ProcessPm -> p1OutputOnf
        activate p1OutputOnf #LightCyan

          note over p1OutputOnf
            Create ONF format
          end note

          p1OutputOnf -> p1FieldsFilter
          activate p1FieldsFilter #LightBlue

            note over p1FieldsFilter
              Reduces structure of
              ONF output format
            end note

          p1OutputOnf <-- p1FieldsFilter
          deactivate p1FieldsFilter

        p1ProcessPm <-- p1OutputOnf : {onfOutputFormat}
        deactivate p1OutputOnf

        p1ProcessPm -> p1Trans
        activate p1Trans #LightBlue

          note over p1Trans
            Transmit object to
            KafkaProducerService
          end note

        p1ProcessPm <-- p1Trans
        deactivate p1Trans

        p1ProcessPm -> p1Store
        activate p1Store #LightCyan

          note over p1Store
            Store resultCc
            to DataStore
          end note

        p1ProcessPm <-- p1Store
        deactivate p1Store

      deactivate p1ProcessPm

    end Loop

  end Loop

@enduml
