@startuml hl_sequence
skinparam responseMessageBelowArrow true

title
  DevicePerformanceManagementDataProcessor
end title

participant "embedYourself\n" as embed
participant "p1ReplicateMwdiEs\n" as p1RMWDI #LightCyan
participant "p1LoadParameters\n" as p1LP #LightCyan

participant "p1ProcessingPmData\n" as p1ProOrch #LightCyan

participant "p1LoadRawCc\n" as p1AddRaw #LightCyan
database  "MWDI ES\nReplica" as MwdiEs #LightCyan
participant "p1FieldsFilter\n" as p1FF #LightCyan

participant "p1CreateResultCc\n" as p1CRC #LightCyan
participant "p1Default\nValueTreatment" as p1DVT #LightBlue
participant "p1OutOfRange\nValueTreatment" as p1ORVT #LightBlue

participant "p1AirInterface\nCapacityCalculation" as p1AiCC #LightBlue
participant "p1Ethernet\nKpiCalculation" as p1EthKC #LightBlue

participant "p1Formatting\nOutputApt" as p1Output #LightCyan
participant "p1Compute\nAirInterfaceNames" as p1CompAiNames #LightCyan
participant "p1Compute\nAirInterfacePhysicalLag" as p1CompPhyLag #LightCyan
participant "p1Compute\nEthContainerNames" as p1CompEthContNames #LightCyan

participant "p1Transmitting\nKafka" as p1Trans #LightCyan

participant "p1Storing\n" as p1Store #LightBlue
database "dataStore" as db #LightBlue


activate p1RMWDI #LightCyan

embed -> p1RMWDI

note over p1RMWDI
  Automatically start
  p1ReplicateMwdiEs
end note

p1RMWDI -> p1LP
activate p1LP #LightCyan

  note over p1LP
    Load parameters
    from configFile
  end note

p1RMWDI <-- p1LP
deactivate p1LP

note over p1RMWDI
  Cyclically update
  MWDI ES Replica
end note

p1RMWDI -> p1ProOrch : for every\nupdated CC
activate p1ProOrch #LightCyan

  note over p1ProOrch
    Create
    DataStructureForProcessing
  end note

  p1ProOrch -> p1AddRaw
  activate p1AddRaw #LightCyan

    p1AddRaw -> MwdiEs
    p1AddRaw <-- MwdiEs

    p1AddRaw -> p1FF
    activate p1FF #LightCyan

      note over p1FF
        Reduce structure of rawCC
      end note

    p1AddRaw <-- p1FF
    deactivate p1FF

    p1AddRaw -> db
    p1AddRaw <-- db

    note over p1AddRaw
      Delete PM data that has
      already been processed in past
    end note

  p1ProOrch <-- p1AddRaw
  deactivate p1AddRaw

  note over p1ProOrch
    Add rawCC to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1CRC
  activate p1CRC #LightCyan

    note over p1CRC
      Create resultCC
      from rawCC
    end note

    p1CRC -> p1DVT
    activate p1DVT #LightBlue

      note over p1DVT
        Delete attributes with ONF
        default value from resultCC
      end note

    p1CRC <-- p1DVT
    deactivate p1DVT

    p1CRC -> p1ORVT
    activate p1ORVT #LightBlue

      note over p1ORVT
        Delete attributes with value outside
        pre-defined range from resultCC
      end note

    p1CRC <-- p1ORVT
    deactivate p1ORVT

    p1CRC -> p1AiCC
    activate p1AiCC #LightBlue

      note over p1AiCC
        Add AirInterface capacity
        to resultCC
      end note

    p1CRC <-- p1AiCC
    deactivate p1AiCC

    p1CRC -> p1EthKC
    activate p1EthKC #LightBlue

      note over p1EthKC
        Add Ethernet KPIs
        to resultCC
      end note

    p1CRC <-- p1EthKC
    deactivate p1EthKC

  p1ProOrch <-- p1CRC
  deactivate p1CRC

  note over p1ProOrch
    Add resultCC to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1Output
  activate p1Output #LightCyan

    note over p1Output
      Create APT format
      from resultCC
    end note

    p1Output -> p1CompAiNames
    activate p1CompAiNames #LightCyan

      note over p1CompAiNames
        Determine LinkId 
        and LinkEndpointId
      end note

    p1Output <-- p1CompAiNames
    deactivate p1CompAiNames

    p1Output -> p1CompPhyLag
    activate p1CompPhyLag #LightCyan

      note over p1CompPhyLag
        Determine LinkIds and
        PortNames (WireInterfaces)
        in aggregation group
      end note

    p1Output <-- p1CompPhyLag
    deactivate p1CompPhyLag

    p1Output -> p1CompEthContNames
    activate p1CompEthContNames #LightCyan

      note over p1CompEthContNames
        Determine PortNames
        of EthernetContainers
      end note

    p1Output <-- p1CompEthContNames
    deactivate p1CompEthContNames

    note over p1Output
      Consolidate data
      into APT format
    end note

  p1ProOrch <-- p1Output
  deactivate p1Output

  note over p1ProOrch
    Add APT format to
    DataStructureForProcessing
  end note

  p1ProOrch -> p1Trans
  activate p1Trans #LightCyan

    note over p1Trans
      Transmit APT format
    end note

  p1ProOrch <-- p1Trans
  deactivate p1Trans

  p1ProOrch -> p1Store
  activate p1Store #LightBlue

    note over p1Store
      Store resultCC
    end note

    p1Store -> db

  p1ProOrch <-- p1Store
  deactivate p1Store

deactivate p1ProOrch

@enduml
