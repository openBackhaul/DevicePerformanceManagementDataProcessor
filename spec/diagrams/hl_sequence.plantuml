@startuml hl_sequence
skinparam responseMessageBelowArrow true

title
  DevicePerformanceManagementDataProcessor
end title

participant "embedYourself\n" as embed #PapayaWhip
participant "p1StreamPmData\n" as p1StreamPm #PapayaWhip
participant "p1LoadParameters\n" as p1LoadParams #PapayaWhip
participant "p1ResolveEsAddress\n" as p1ResolveAddress #PapayaWhip
participant "p1InitKafka\n" as p1InitKafka #PapayaWhip
participant "p1UpdateMwdiReplica\n" as p1UpdateMwdiRep #PapayaWhip

participant "p1ProcessDevice\n" as p2ProcessPm #PapayaWhip
  participant "p2ProcessDevice\n" as p2ProcessPm #LightSalmon

participant "p1LoadOffsets\nAndStatusData" as p1LoadStatus #LightSalmon
participant "p1LoadRawCc\n" as p1AddRaw #PapayaWhip
  participant "p2LoadRawCc\n" as p2AddRaw #LightSalmon
participant "p1FieldsFilter\n" as p1FieldsFilter #PapayaWhip
participant "p1DiscardIrrelevant\nPmRecords" as p1filterPm #LightCyan
  participant "p2DiscardIrrelevant\nPmRecords" as p2filterPm #LightSalmon

participant "p1CreateResultCc\n" as p1CreateResultCc #PapayaWhip
participant "p1Prepare\nTxModes" as p1prepTxModes #LightCyan
participant "p1Calculate\nAiCapacity" as aiCC #LightCyan
participant "p1IterateAi\nPmSlices" as aiSlices #LightCyan
participant "p1Calculate\nIntervalCapacity" as intCC #LightCyan
participant "p1RemoveOutOf\nRangeLevels" as p1RORL #LightCyan
participant "p1Remove\nDefaultValues" as p1RemDefault #LightCyan
participant "p1IterateEc\nPmSlices" as ecSlices #LightCyan
participant "p1Calculate\nEthernetKpis" as p1EthKpi #LightCyan
participant "p1Calculate\nUtilization" as p1Util #LightCyan
participant "p1Categorize\nDataVolume" as p1CatDV #LightSalmon
participant "p1CalculateBusyHour\nPerformanceIndicators" as p1CalcBH #LightSalmon
participant "p1RemoveOutOf\nRangeTemperature" as p1ROoRT #LightCyan

participant "p1Formatting\nOutputApt" as p1OutputApt #LightCyan
participant "p1Formatting\nOutputOnf" as p1OutputOnf #LightCyan

participant "p1Transmitting\nKafka" as p1Trans #PapayaWhip

participant "p1Storing\n" as p1Store #PapayaWhip
participant "p1MaintainDs\n" as p1MaintainDs #PapayaWhip

note right embed
  Automatically starts
  p1StreamPmData
end note
embed -> p1StreamPm

activate p1StreamPm

  p1StreamPm -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads parameters
      from configFile
    end note
  p1StreamPm <-- p1LoadParams
  deactivate p1LoadParams

  Loop FOR all esName
    p1StreamPm -> p1ResolveAddress
    activate p1ResolveAddress
      note over p1ResolveAddress
        Resolves ES address
      end note
    p1StreamPm <-- p1ResolveAddress
    deactivate p1ResolveAddress

  end Loop

  p1StreamPm -> p1InitKafka
  activate p1InitKafka

    note over p1InitKafka
      Resolves Kafka
      address
    end note

    note over p1InitKafka
      Establishes Kafka
      session
    end note

  p1StreamPm <-- p1InitKafka
  deactivate p1InitKafka

  p1StreamPm -> p1MaintainDs
  activate p1MaintainDs

  Loop endless
    note over p1MaintainDs
      Deletes old
      resultCc
    end note
  end loop

  Loop endless

    p1StreamPm -> p1UpdateMwdiRep
    activate p1UpdateMwdiRep
      note over p1UpdateMwdiRep
        Replicates updated CCs
      end note
    p1StreamPm <-- p1UpdateMwdiRep
    deactivate p1UpdateMwdiRep

    Loop for every updated CC

      p1StreamPm -> p2ProcessPm
      activate p2ProcessPm

        p2ProcessPm -> p1AddRaw
        activate p1AddRaw

          note over p1AddRaw
            Loads raw data to rawCc
          end note

          p1AddRaw -> p1FieldsFilter
          activate p1FieldsFilter

            note over p1FieldsFilter
              Reduces structure of rawCc
            end note

          p1AddRaw <-- p1FieldsFilter
          deactivate p1FieldsFilter

          note over p1AddRaw
            Get mostRecentPeriodEndTimes
          end note

          p1AddRaw -> p1filterPm
          activate p1filterPm

            note over p1filterPm
              Deletes PM data that has
              already been processed in past
            end note

          p1AddRaw <-- p1filterPm
          deactivate p1filterPm

          note over p1AddRaw
            addBatchTimestamp
          end note

        p2ProcessPm <-- p1AddRaw : {rawCc}
        deactivate p1AddRaw

        p2ProcessPm -> p1CreateResultCc
        activate p1CreateResultCc

          note over p1CreateResultCc
            Copies rawCc to resultCc
          end note

          note over p1CreateResultCc
            Creates aggregationGroupList
          end note

          loop FOR all AirInterfaces in resultCc

            p1CreateResultCc -> p1prepTxModes
            activate p1prepTxModes

              note over p1prepTxModes
                Prepares TxModes
              end note

              p1prepTxModes -> aiCC
              activate aiCC

                note over aiCC
                  Calculates
                  AirInterfaceCapacity
                end note

              p1prepTxModes <-- aiCC
              deactivate aiCC

            p1CreateResultCc <-- p1prepTxModes
            deactivate p1prepTxModes

            p1CreateResultCc -> aiSlices
            activate aiSlices

                aiSlices -> intCC
                activate intCC

                  note over intCC
                    Calculates
                    IntervalCapacity
                  end note

                aiSlices <-- intCC
                deactivate intCC

                aiSlices -> p1RORL
                activate p1RORL

                  note over p1RORL
                    Deletes RxLevel and TxLevel
                    attributes with values
                    outside pre-defined range
                  end note

                aiSlices <-- p1RORL
                deactivate p1RORL

                aiSlices -> p1RemDefault
                activate p1RemDefault

                  note over p1RemDefault
                    Deletes attributes with
                    ONF default value
                  end note

                aiSlices <-- p1RemDefault
                deactivate p1RemDefault

                note over aiSlices
                  Derives most recent
                  periodEndTime
                end note

            p1CreateResultCc <-- aiSlices
            deactivate aiSlices

            note over p1CreateResultCc
              Update interfaceMetadata
            end note

            note over p1CreateResultCc
              Add linkId
            end note

            note over p1CreateResultCc
              Add list of parallel LTPs
            end note

          end loop

          loop FOR all EthernetContainers in resultCc

            p1CreateResultCc -> ecSlices
            activate ecSlices

              ecSlices -> p1EthKpi
              activate p1EthKpi

                note over p1EthKpi
                  Add Ethernet KPIs
                end note

              ecSlices <-- p1EthKpi
              deactivate p1EthKpi

              ecSlices -> p1RemDefault
              activate p1RemDefault

                note over p1RemDefault
                  Deletes default values
                  from Ec Pm data
                end note

              ecSlices <-- p1RemDefault
              deactivate p1RemDefault

              ecSlices -> p1Util
              activate p1Util

                note over p1Util
                  Add utilization
                end note

              ecSlices <-- p1Util
              deactivate p1Util

              note over ecSlices
                Derives most recent
                periodEndTime
              end note

            p1CreateResultCc <-- ecSlices
            deactivate ecSlices

            note over p1CreateResultCc
              Update interfaceMetadata
            end note

          end loop

          p1CreateResultCc -> p1ROoRT
          activate p1ROoRT

            note over p1ROoRT
              Delete temperature attributes with
              values outside pre-defined range
            end note

          p1CreateResultCc <-- p1ROoRT
          deactivate p1ROoRT

        p2ProcessPm <-- p1CreateResultCc : {resultCc}
        deactivate p1CreateResultCc

        p2ProcessPm -> p1OutputApt
        activate p1OutputApt

          note over p1OutputApt
            Create APT format
          end note

        p2ProcessPm <-- p1OutputApt : {aptOutputFormat}
        deactivate p1OutputApt

        p2ProcessPm -> p1OutputOnf
        activate p1OutputOnf

          note over p1OutputOnf
            Create ONF format
          end note

          p1OutputOnf -> p1FieldsFilter
          activate p1FieldsFilter

            note over p1FieldsFilter
              Reduces structure of
              ONF output format
            end note

          p1OutputOnf <-- p1FieldsFilter
          deactivate p1FieldsFilter

        p2ProcessPm <-- p1OutputOnf : {onfOutputFormat}
        deactivate p1OutputOnf

        p2ProcessPm -> p1Trans
        activate p1Trans

          note over p1Trans
            Transmit object to
            KafkaProducerService
          end note

        p2ProcessPm <-- p1Trans
        deactivate p1Trans

        p2ProcessPm -> p1Store
        activate p1Store

          note over p1Store
            Store resultCc
            to DataStore
          end note

        p2ProcessPm <-- p1Store
        deactivate p1Store

      deactivate p2ProcessPm

      p1StreamPm -> p2ProcessPm
      activate p2ProcessPm

        p2ProcessPm -> p1LoadStatus
        activate p1LoadStatus

          note over p1LoadStatus
            Loads offsets and status data
            from DataStore
          end note

        p2ProcessPm <-- p1LoadStatus
        deactivate p1LoadStatus

        p2ProcessPm -> p2AddRaw
        activate p2AddRaw

          note over p2AddRaw
            Loads raw data to rawCc
          end note

          p2AddRaw -> p1FieldsFilter
          activate p1FieldsFilter

            note over p1FieldsFilter
              Reduces structure of rawCc
            end note

          p2AddRaw <-- p1FieldsFilter
          deactivate p1FieldsFilter

          p2AddRaw -> p2filterPm
          activate p2filterPm

            note over p2filterPm
              Deletes PM data that has
              already been processed in past
            end note

          p2AddRaw <-- p2filterPm
          deactivate p2filterPm

          note over p2AddRaw
            addBatchTimestamp
          end note

        p2ProcessPm <-- p2AddRaw : {rawCc}
        deactivate p2AddRaw

      deactivate p2ProcessPm

    end Loop

  end Loop

@enduml
