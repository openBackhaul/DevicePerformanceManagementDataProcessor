@startuml hl_sequence_1.2.0
skinparam responseMessageBelowArrow true

skinparam ParticipantBorderColor<<no lot !>> Red
skinparam ParticipantBorderThickness<<no lot !>> 5
skinparam ParticipantBackgroundColor<<no lot !>> White

title
  DevicePerformanceManagementDataProcessor
end title

'new pxVersion: #LightBlue
'same pxVersion, but 1.1.0 instead of 1.0.0: #LightCyan
'totally new function: #LightCoral

'still to be discussed: potentially to be changed to ...
'1.1.0 version: #LightYellow
'new px: #LightGreen
'no new version required, because previously no lot: #LightPink

participant "embedYourself\n" as embed
participant "provideDevice\nDataStoreDump" as deviceDump
participant "documentPmData\nProcessing" as docuPm
participant "initiatePm\nDataUpdate" as initPmData
participant "p2Stream\nPmData" as p2StreamPm #LightCyan
participant "p1LoadParameters\n" as p1LoadParams
participant "p2Resolve\nEsAddress" as p2ResolveAddress #LightBlue
participant "p1InitKafka\n" as p1InitKafka #LightCyan
participant "p1Update\nMwdiReplica" as p1UpdateMwdiRep

participant "p3Process\nDevice" as p3ProcessPm #LightBlue

participant "p1LoadOffsets\nAndStatusData" as p1LoadStatus
participant "p3LoadRawCc\n" as p3AddRaw #LightBlue
participant "p1ReduceData\n" as p1ReduceData #LightCoral


participant "p2DiscardIrrelevant\nPmRecords" as p2filterPm
participant "p1CalculateInterface\nPmDataQuality" as calPmQual

participant "p3Create\nResultCc" as p3CreateResultCc #LightBlue
participant "p2Prepare\nTxModes" as p1prepTxModes
participant "p1Calculate\nAiCapacity" as aiCC
participant "p2IterateAi\nPmSlices" as aiSlices #LightYellow
participant "p1Calculate\nIntervalCapacity" as intCC
participant "p1RemoveOutOf\nRangeLevels" as p1RORL
participant "p1Remove\nDefaultValues" as p1RemDefault
participant "p2IterateEc\nPmSlices" as ecSlices #LightGreen
participant "p1Calculate\nEthernetKpis" as p1EthKpi #LightYellow
participant "p2Calculate\nUtilization" as p2Util <<no lot !>> #LightPink
participant "p1Categorize\nDataVolume" as p1CatDV
participant "p1CalculateBusyHour\nPerformanceIndicators" as p1CalcBH
participant "p1RemoveOutOf\nRangeTemperature" as p1ROoRT

participant "p2Formatting\nOutputApt" as p2OutputApt #LightBlue
participant "p2Formatting\nOutputOnf" as p1OutputOnf #LightCyan

participant "p1ExtractData\n" as p1ExtractData #LightCoral

participant "p1Transmitting\nKafka" as p1Trans #LightCyan

participant "p2Storing\n" as p2Store
participant "p1MaintainDs\n" as p1MaintainDs
participant "p1ReadData\nStoreDeviceData" as p1ReadDevice
participant "p1Document\nFunction" as p1Doc


note right embed
  Automatically starts
  p2StreamPmData
end note
embed -> p2StreamPm
activate p2StreamPm

  ' Load parameters
  p2StreamPm -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads parameters
      from configFile
    end note
  p2StreamPm <-- p1LoadParams
  deactivate p1LoadParams

  ' Resolve ES address
  loop FOR all esName
    p2StreamPm -> p2ResolveAddress
    activate p2ResolveAddress
      note over p2ResolveAddress
        Resolves ES address
      end note
    p2StreamPm <-- p2ResolveAddress
    deactivate p2ResolveAddress

  end loop

  ' Init Kafka
  p2StreamPm -> p1InitKafka
  activate p1InitKafka

    note over p1InitKafka
      Resolves Kafka
      address
    end note

    note over p1InitKafka
      Establishes Kafka
      session
    end note

  p2StreamPm <-- p1InitKafka
  deactivate p1InitKafka

  ' Maintain DataStore
  p2StreamPm -> p1MaintainDs
  activate p1MaintainDs

  loop endless
    note over p1MaintainDs
      Deletes old
      resultCc
    end note
  end loop

  loop endless

    ' Update MWDI replica
    p2StreamPm -> p1UpdateMwdiRep
    activate p1UpdateMwdiRep
      note over p1UpdateMwdiRep
        Replicates updated CCs
      end note
    p2StreamPm <-- p1UpdateMwdiRep
    deactivate p1UpdateMwdiRep

    group partially parallel execution of all updatedMountNames

      ' ProcessDevice
      p2StreamPm -> p3ProcessPm
      activate p3ProcessPm


        ' Load offsets and statusData
        p3ProcessPm -> p1LoadStatus
        activate p1LoadStatus

          note over p1LoadStatus
            Loads offsets and status data
            from DataStore
          end note

        p3ProcessPm <-- p1LoadStatus
        deactivate p1LoadStatus

        ' Load RawCC
        p3ProcessPm -> p3AddRaw
        activate p3AddRaw

          note over p3AddRaw
            Loads raw data to rawCc
          end note

          ' Apply fieldsFilter
          p3AddRaw -> p1ReduceData
          activate p1ReduceData

            note over p1ReduceData
              Reduces structure of rawCc
            end note

          p3AddRaw <-- p1ReduceData
          deactivate p1ReduceData

          ' DiscardIrrelvantPmRecords
          p3AddRaw -> p2filterPm
          activate p2filterPm

            note over p2filterPm
              Deletes PM data that has
              already been processed in past
            end note

          p3AddRaw <-- p2filterPm
          deactivate p2filterPm

          ' Calculate PM data quality
          p3AddRaw -> calPmQual
          activate calPmQual

            note over calPmQual
              Calculates quality
              of PM data
            end note

          p3AddRaw <-- calPmQual
          deactivate calPmQual

          note over p3AddRaw
            addBatchTimestamp
          end note

          note over p3AddRaw
            update offset
          end note

        p3ProcessPm <-- p3AddRaw : {rawCc}
        deactivate p3AddRaw

        ' Create resultCC
        p3ProcessPm -> p3CreateResultCc
        activate p3CreateResultCc

          note over p3CreateResultCc
            Copies rawCc to resultCc
          end note

          note over p3CreateResultCc
            Creates aggregationGroupList
          end note

          ' AirInterfaces
          loop FOR all AirInterfaces in resultCc

            ' prepTxModes
            p3CreateResultCc -> p1prepTxModes
            activate p1prepTxModes

              note over p1prepTxModes
                Prepares TxModes
              end note

              p1prepTxModes -> aiCC
              activate aiCC

                note over aiCC
                  Calculates
                  AirInterfaceCapacity
                end note

              p1prepTxModes <-- aiCC
              deactivate aiCC

            p3CreateResultCc <-- p1prepTxModes
            deactivate p1prepTxModes

            ' iterateAiPmSlices
            p3CreateResultCc -> aiSlices
            activate aiSlices

                ' capacityCalculation
                aiSlices -> intCC
                activate intCC

                  note over intCC
                    Calculates
                    IntervalCapacity
                  end note

                aiSlices <-- intCC
                deactivate intCC

                ' RemoveOutOfRangeLevelValues
                aiSlices -> p1RORL
                activate p1RORL

                  note over p1RORL
                    Deletes RxLevel and TxLevel
                    attributes with values
                    outside pre-defined range
                  end note

                aiSlices <-- p1RORL
                deactivate p1RORL

                ' RemoveOnfDefaultValues
                aiSlices -> p1RemDefault
                activate p1RemDefault

                  note over p1RemDefault
                    Deletes attributes with
                    ONF default value
                  end note

                aiSlices <-- p1RemDefault
                deactivate p1RemDefault

            p3CreateResultCc <-- aiSlices
            deactivate aiSlices

            note over p3CreateResultCc
              Add linkId
            end note

            note over p3CreateResultCc
              Add list of parallel LTPs
            end note

          end loop


          ' EthernetContainers
          loop FOR all EthernetContainers in resultCc

            ' IterateEcPmSlices
            p3CreateResultCc -> ecSlices
            activate ecSlices

              'EthernetKPIs
              ecSlices -> p1EthKpi
              activate p1EthKpi

                note over p1EthKpi
                  Add Ethernet KPIs
                end note

              ecSlices <-- p1EthKpi
              deactivate p1EthKpi

              ' RemoveOnfDefaultValues
              ecSlices -> p1RemDefault
              activate p1RemDefault

                note over p1RemDefault
                  Deletes default values
                  from Ec Pm data
                end note

              ecSlices <-- p1RemDefault
              deactivate p1RemDefault

              ' Utilization
              ecSlices -> p2Util
              activate p2Util

                note over p2Util
                  Add utilization
                end note

              ecSlices <-- p2Util
              deactivate p2Util

              ' categorizeDataVolume
              ecSlices -> p1CatDV
              activate p1CatDV

                note over p1CatDV
                  Categorize total-bytes-output values
                end note

              ecSlices <- p1CatDV
              deactivate p1CatDV

              ' calculateBH
              ecSlices -> p1CalcBH
              activate p1CalcBH

                note over p1CalcBH
                  Calculate busy hour KPIs
                end note

              ecSlices <- p1CalcBH
              deactivate p1CalcBH


            p3CreateResultCc <-- ecSlices
            deactivate ecSlices

            note over p3CreateResultCc
              Update statusData
            end note

          end loop

        ' RemoveOutOfRangeTemperatureValues
          p3CreateResultCc -> p1ROoRT
          activate p1ROoRT

            note over p1ROoRT
              Delete temperature attributes with
              values outside pre-defined range
            end note

          p3CreateResultCc <-- p1ROoRT
          deactivate p1ROoRT

        p3ProcessPm <-- p3CreateResultCc : {resultCc}
        deactivate p3CreateResultCc

        ' OutputApt
        p3ProcessPm -> p2OutputApt
        activate p2OutputApt

          note over p2OutputApt
            Create APT format
          end note

        p3ProcessPm <-- p2OutputApt : {aptOutputFormat}
        deactivate p2OutputApt

        ' OutputOnf
        p3ProcessPm -> p1OutputOnf
        activate p1OutputOnf

          loop FOR all ONF output formats

            note over p1OutputOnf
              Create ONF format
            end note

            p1OutputOnf -> p1ExtractData
            activate p1ExtractData

              note over p1ExtractData
                Reduces structure of
                ONF output format
              end note

            p1OutputOnf <-- p1ExtractData
            deactivate p1ExtractData

          end loop

        p3ProcessPm <-- p1OutputOnf : [onfOutputFormat]
        deactivate p1OutputOnf

        ' KafkaTransmission
        p3ProcessPm -> p1Trans
        activate p1Trans

          note over p1Trans
            Transmit object (PmData)
            to KafkaProducerService
          end note

        p3ProcessPm <-- p1Trans
        deactivate p1Trans

        ' Storing
        p3ProcessPm -> p2Store
        activate p2Store

          note over p2Store
            Store resultCc, offsets and
            status data to DataStore
          end note

        p3ProcessPm <-- p2Store
        deactivate p2Store

      p2StreamPm <-- p3ProcessPm : {pmDataQuality}
      deactivate p3ProcessPm

    end group

    ' KafkaTransmission
    p2StreamPm -> p1Trans
    activate p1Trans

      note over p1Trans
        Transmit object (quality)
        to KafkaProducerService
      end note

    p2StreamPm <-- p1Trans
    deactivate p1Trans

  end loop


-> deviceDump
activate deviceDump

  deviceDump -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads parameters
      from configFile
    end note
  deviceDump <-- p1LoadParams
  deactivate p1LoadParams

    deviceDump -> p2ResolveAddress
    activate p2ResolveAddress
      note over p2ResolveAddress
        Resolves ES address
      end note
    deviceDump <-- p2ResolveAddress
    deactivate p2ResolveAddress

    deviceDump -> p1ReadDevice
    activate p1ReadDevice
      note over p1ReadDevice
        Reads device PM
        data from DataStore
      end note
    deviceDump <-- p1ReadDevice
    deactivate p1ReadDevice

<-- deviceDump
deactivate deviceDump


-> docuPm
activate docuPm

  docuPm -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads own parameters
      from configFile
    end note
  docuPm <-- p1LoadParams
  deactivate p1LoadParams

  docuPm -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads parameters of PM
      data processing function
      from configFile
    end note
  docuPm <-- p1LoadParams
  deactivate p1LoadParams

  docuPm -> p1Doc
  activate p1Doc
    note over p1Doc
      Creates documentation
      from {parameters}
    end note
  docuPm <-- p1Doc
  deactivate p1Doc

<-- docuPm
deactivate docuPm


-> initPmData
activate initPmData

  initPmData -> p1LoadParams
  activate p1LoadParams
    note over p1LoadParams
      Loads parameters
      from configFile
    end note
  initPmData <-- p1LoadParams
  deactivate p1LoadParams

  loop
    note over initPmData
      Triggers liveCC
      path at MWDI
    end note
  end loop
<-- initPmData
deactivate initPmData

@enduml
