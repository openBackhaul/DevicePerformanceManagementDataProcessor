{
  "type": "object",
  "required": [
    "parameters",
    "configFile"
  ],
  "properties": {
    "parameters": {
      "$ref": "#/definitions/parameters-schema",
      "description": "Parameters of the Function from [/load-parameters/parameters]"
    },
    "config-file": {
      "type": "object",
      "description": "configFile content from [/load-parameters/config-file]",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "parameters-schema": {
      "type": "object",
      "required": [
        "function-name",
        "description",
        "is-active",
        "parameter",
        "sub-function"
      ],
      "properties": {
        "function-name": {
          "type": "string",
          "description": "operationId (from the OAS) as a unique and invariant identifier of the module"
        },
        "description": {
          "type": "string",
          "description": "Human readable description of the Function"
        },
        "is-active": {
          "type": "boolean",
          "description": "true = the Function shall be executed"
        },
        "parameter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "parameter-name",
              "purpose",
              "owner",
              "value"
            ],
            "properties": {
              "parameter-name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "owner": {
                "type": "string",
                "enum": [
                  "platform",
                  "engineering",
                  "user"
                ]
              },
              "value": {
                "type": "string"
              },
              "enumeration": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pattern": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sub-function": {
          "type": "array",
          "description": "List of sub-Functions incl. their parameter settings",
          "items": {
            "$ref": "#/definitions/parameters-schema"
          }
        }
      },
      "additionalProperties": true
    }
  }
}