{
  "type": "object",
  "required": ["interface-status"],
  "properties": {
    "interface-status": {
      "type": "object",
      "required": ["uuid"],
      "properties": {
        "uuid": {
          "type": "string"
        },
        "15-minute-values-by-day": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["day", "15-minute-values-by-hour"],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "15-minute-values-by-hour": {
                "type": "array",
                "minItems": 24,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "required": ["hour", "15-minute-values"],
                  "properties": {
                    "hour": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 23
                    },
                    "15-minute-values": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": ["period-end-time"],
                        "properties": {
                          "period-end-time": {
                            "type": "string"
                          },
                          "total-bytes-output": {
                            "type": "integer"
                          },
                          "total-air-interface-interval-capacity": {
                            "type": "integer"
                          },
                          "errored-frames-input": {
                            "type": "integer"
                          },
                          "dropped-frames-input": {
                            "type": "integer"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}